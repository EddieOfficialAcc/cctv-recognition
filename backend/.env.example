DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=cctv_recognition
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=false

# Use false only for local HTTP development. HTTPS deployments must use true.
AUTH_COOKIE_SECURE=true

# Set the replacement key privately. Images are sent to this vision API.
VISION_ENDPOINT=https://dify-ai-llm.services.ai.azure.com/openai/v1
VISION_DEPLOYMENT=gpt-6.2-sol
VISION_API_KEY=
VISION_DRIFT_SECONDS=180

# The separate inspection worker is disabled unless explicitly set to true.
SCHEDULED_INSPECTION_ENABLED=false
